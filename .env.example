# Copie para .env e ajuste. Nunca commit o .env.

# Público (Caddy)
PUBLIC_HOST=localhost
# Depois do DNS: PUBLIC_HOST=30anos.inf.ufg.br
# REVIEW_HOST=revisao.30anos.inf.ufg.br

# Revisão — HTTP Basic (Caddy + API)
REVIEW_USERNAME=revisao
REVIEW_PASSWORD=altere-esta-senha
# Gere com: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext 'sua-senha'
REVIEW_PASSWORD_HASH=$$2b$$12$$SUBSTITUA_PELO_HASH
# Escape cada $ como $$ no .env lido pelo Docker Compose.

# PostgreSQL
POSTGRES_USER=acervo
POSTGRES_PASSWORD=altere-postgres
POSTGRES_DB=acervo30
DATABASE_URL=postgresql+psycopg://acervo:altere-postgres@postgres:5432/acervo30

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=altere-minio-admin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# API
API_CORS_ORIGINS=http://localhost,http://127.0.0.1
MAX_UPLOAD_BYTES=20971520
MAX_FILES_PER_SUBMISSION=10
IMAGE_PROVIDER=mock
LLM_PROVIDER=mock

# Site (Astro build-time)
PUBLIC_API_BASE=/api
